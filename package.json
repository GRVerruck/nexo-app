{
  "name": "nexo-app",
  "version": "1.0.0",
  "description": "NEXO — Gestão de Produtos e Controle de Estoque em Consignações",
  "main": "dist-electron/main/index.js",
  "author": "NEXO",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --win nsis",
    "build:dir": "vite build && electron-builder --win dir",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "sass": "^1.83.0",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-vuetify": "^2.0.4"
  },
  "build": {
    "appId": "com.nexo.app",
    "productName": "NEXO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "src/data/**/*"
    ],
    "extraResources": [
      {
        "from": "src/data/initialSeed.json",
        "to": "data/initialSeed.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEXO"
    }
  }
}
